{
  "id": "socErrors0000001",
  "name": "SOC pipeline - errors",
  "nodes": [
    {
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c01",
      "name": "Workflow failed",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c02",
      "name": "Failure line",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "{{file:n8n/code/failure_line.js}}"
      }
    },
    {
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c03",
      "name": "Write to pipeline log",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        440,
        200
      ],
      "parameters": {
        "operation": "write",
        "fileName": "/home/node/pipeline-log/pipeline.jsonl",
        "dataPropertyName": "data",
        "options": {
          "append": true
        }
      }
    },
    {
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c04",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        200
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "{{TELEGRAM_CHAT_ID}}",
        "text": "={{ $('Failure line').first().json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "{{cred:Telegram bot}}",
          "name": "Telegram bot"
        }
      }
    }
  ],
  "connections": {
    "Workflow failed": {
      "main": [
        [
          {
            "node": "Failure line",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Failure line": {
      "main": [
        [
          {
            "node": "Write to pipeline log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write to pipeline log": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}
