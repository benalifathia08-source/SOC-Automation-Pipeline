# Files deployed to the Linux VMs (Wazuh server, tools VM) must keep LF line endings
*.py               text eol=lf
*.js               text eol=lf
*.sh               text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf
*.json             text eol=lf
*.xml              text eol=lf
*.conf             text eol=lf
wazuh/integrations/custom-n8n  text eol=lf

# Windows scripts stay CRLF
*.ps1              text eol=crlf
*.cmd              text eol=crlf

# Images are never touched by line-ending conversion
*.png              binary
